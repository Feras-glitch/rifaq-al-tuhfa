{
  "name": "rifaq-al-tuhfa",
  "productName": "Rifaq al-Tuhfa",
  "version": "9.39.12",
  "description": "رفاق التحفة — تعليم التجويد للأطفال على متن تحفة الأطفال",
  "author": "Feras",
  "homepage": "https://github.com/Feras-glitch/rifaq-al-tuhfa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.rifaq.tuhfa",
    "productName": "Rifaq al-Tuhfa",
    "copyright": "© 2026 Feras",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "build/icon.png", "site/**/*"],
    "asar": false,
    "win": {
      "target": [ { "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] } ],
      "icon": "build/icon.png",
      "executableName": "RifaqAlTuhfa"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "رفاق التحفة",
      "artifactName": "Rifaq-al-Tuhfa-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Rifaq-al-Tuhfa-Portable-${version}.${ext}" }
  }
}
